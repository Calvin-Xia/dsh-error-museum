{
  "name": "dsh-error-museum",
  "version": "0.3.0",
  "type": "module",
  "description": "An error museum for DeepSeek Harness: turns the last N days of confirmed failures into exhibits, grouped by how the model handled each one, and keeps the real trajectory and verbatim error around it.",
  "icon": "icon.svg",
  "author": "Calvin-Xia (https://github.com/Calvin-Xia)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Calvin-Xia/dsh-error-museum.git"
  },
  "homepage": "https://github.com/Calvin-Xia/dsh-error-museum#readme",
  "bugs": {
    "url": "https://github.com/Calvin-Xia/dsh-error-museum/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "session",
    "insights",
    "museum",
    "errors",
    "dashboard"
  ]
}
