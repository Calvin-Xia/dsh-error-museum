{
  "name": "dsh-session-insights",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "错误博物馆：把最近 N 天的 DSH 失败做成展品，按模型的处置分馆陈列，并保留每次失败前后的真实轨迹（重试 / 自省 / 交还 / 搁置）。",
  "icon": "icon.svg",
  "author": "",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "session",
    "insights",
    "museum",
    "errors",
    "dashboard"
  ]
}
